[Unit]
Description=Encrypted server backup with Restic
Documentation=file:///opt/server-backup/README.md
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/server-backup
Environment=BACKUP_TRIGGER=scheduled
ExecStart=/opt/server-backup/scripts/backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true

