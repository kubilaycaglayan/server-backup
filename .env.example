# Copy to .env, customize, then run: sudo chmod 600 .env
RESTIC_REPOSITORY=/mnt/backup-disk/server-backups/restic
RESTIC_PASSWORD=replace-with-a-long-random-password

# Account whose projects and settings should be protected.
BACKUP_USER=example-user
BACKUP_USER_HOME=/home/example-user

# Default timezone and calendar used by systemd/install.sh.
BACKUP_TIMEZONE=Etc/GMT-3
BACKUP_CALENDAR=Sun *-*-* 02:00:00

# Four weekly snapshots and four weeks of local logs.
KEEP_WEEKLY=4
LOG_RETENTION_DAYS=28

# Optional space-separated absolute paths containing irreplaceable HDD data.
EXTRA_BACKUP_PATHS=

